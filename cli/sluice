#!/usr/bin/env python3
"""sluice - virtual memory for LLMs.

Run MoE models bigger than your RAM by streaming experts from disk, with a
calibrated speed<->quality dial and the receipts to back every number.

Commands:
  sluice list             models on disk (and what they'd cost to pull)
  sluice estimate [name]  probe THIS machine, print honest expected tok/s
  sluice run <name>       chat REPL on the persistent warm server
  sluice serve [name]     OpenAI-compatible HTTP API (/v1/chat/completions)
  sluice ui               launch the playground chat UI (streamlit)
  sluice pull <name>      estimator first, then resumable download
  sluice rm <name>        delete a pulled model file

serve/run accept a registry name OR a path to any .gguf. Backend is CPU
(the fast, correct path on Apple Silicon — GPU streaming is slower here, E24).

Every speed number ships with its provenance: measured on the reference
machine (M2 Air 16GB, ~1.7 GB/s cold SSD reads) and scaled by YOUR disk's
measured bandwidth for the I/O-bound modes. No marketing numbers.
"""
import json
import os
import random
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
ENGINE = ROOT / "csrc" / "stream_run"
MODELS_DIR = ROOT / "models"

# Reference machine: everything below was MEASURED there (docs/lablog.md
# E19-E30); io_bound modes scale ~linearly with disk bandwidth vs REF_BW.
REF_BW_GBS = 1.7
