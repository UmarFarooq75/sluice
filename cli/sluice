# Quality modes map to a FAMILY-AGNOSTIC routing-fidelity floor (D3, closed in
# E20): the fraction of the true top-k experts the router must keep. It means
# the SAME thing on gpt-oss (logit-scale gating) and OLMoE/Qwen/DeepSeek
# (prob/sigmoid-scale) — the engine's adaptive controller finds the margin that
# holds it. 'exact' = bit-identical routing (margin 0, reproducible); the
# floored modes trade a little routing fidelity for streaming speed.
MODES = {
    "exact":    {"agree": 0.0,  "margin": 0.0},   # bit-exact, run-reproducible
    "balanced": {"agree": 0.95, "margin": 0.0},   # keep >=95% of routing decisions (E20)
    "fast":     {"agree": 0.90, "margin": 0.0},   # keep >=90%, more speed
}


# gpt-oss reads its reasoning budget from a "Reasoning: <level>" line in the SYSTEM
# prompt — it is not an engine flag, so this is prompt text, not env. Low is the
# default and reproduces the string this CLI hardcoded before the flag existed.
REASONING = ("low", "medium", "high")
CLI_SYSTEM = "You are a helpful, concise assistant. Answer the user's message directly."


def system_with_reasoning(level):
    return f"{CLI_SYSTEM} Reasoning: {level}"


def parse_canon_reply(text):
    """E41b: the engine's canonical assistant text, or None if it did not canonicalize.

    When LLMSTREAM_KV_CANON is on the engine rewrites its KV into the form the chat
    template will render next turn, and prints the exact text that form contains.
    The client MUST echo that back or the KV stops being a prefix of the next render
    and the reuse silently evaporates. None (the default) means no canonicalization
    happened and the caller keeps its own extraction.
    """
    import re as _re
    m = _re.search(r"^canon_reply: (.*)$", text, _re.M)
    if not m:
        return None
    out, s, i = [], m.group(1), 0
    while i < len(s):
        if s[i] == "\\" and i + 1 < len(s):
            out.append("\n" if s[i + 1] == "n" else s[i + 1]); i += 2
        else:
            out.append(s[i]); i += 1
    return "".join(out)


def mode_env(mode):
    m = MODES.get(mode, MODES["balanced"])
    # AGREE_TARGET>0 enables the adaptive controller (seeds from a small margin
    # and climbs to hold the floor); =0 means fixed exact routing.
    return {"LLMSTREAM_AGREE_TARGET": str(m["agree"]), "LLMSTREAM_MARGIN": str(m["margin"])}


def ensure_engine_built():
    """First-run bootstrap: build the engine if it isn't there, so the user
    never has to run cmake/build scripts by hand (ollama-style: it just works)."""
    if ENGINE.exists():
        return True
    lc = ROOT / "vendor" / "llama.cpp"
    # vendor/ is gitignored and there is no submodule, so a FRESH CLONE has no
    # llama.cpp at all. cmake on a directory that doesn't exist fails with an
    # error about CMakeLists.txt that reads like a broken toolchain — send the
    # user to the installer, which is the thing that knows the pinned revision
    # and the fork patch.
    if not (lc / "CMakeLists.txt").exists():
        print(f"{YELLOW}llama.cpp isn't vendored yet (vendor/ is gitignored, so a clone "
              f"doesn't ship it).{RESET}")
        print(f"run the installer once — it fetches the pinned revision, applies the "
              f"fork patch, and builds:\n\n    bash scripts/install.sh\n")
        return False
    print(f"{DIM}first-time setup: building the sluice engine (one-time)…{RESET}")
    if not (lc / "build" / "bin").exists():
        print(f"{DIM}  compiling llama.cpp with Metal — a few minutes…{RESET}")
        # flags kept in step with scripts/install.sh on purpose
        if subprocess.call(["cmake", "-B", str(lc / "build"), "-S", str(lc),
                            "-DGGML_METAL=ON", "-DCMAKE_BUILD_TYPE=Release",
                            "-DLLAMA_CURL=OFF"]) == 0:
            subprocess.call(["cmake", "--build", str(lc / "build"), "--config", "Release", "-j"])
    if subprocess.call(["bash", str(ROOT / "scripts" / "build_driver.sh")]) != 0 or not ENGINE.exists():
        print(f"{YELLOW}engine build failed. Need Xcode CLT + cmake: xcode-select --install{RESET}")
        return False
    print(f"{GREEN}engine ready.{RESET}")
    return True


def avail_ram_gb():
    """Free-ish RAM, in GB, from vm_stat's own reported page size.

    The page size is QUERIED, never assumed. Assuming 4096 is the bug this project
    actually hit (2026-07-21): macOS on Apple Silicon uses 16384, so a hardcoded
    4096 under-reports available memory by 4x — it read 2.58 GB when the machine
    genuinely had 10.7 GB free, and aborted runs that would have been fine.
    Same four buckets as every gate script in results/, so the numbers agree.
    """
    if sys.platform != "darwin":
        return None
    out = subprocess.run(["vm_stat"], capture_output=True, text=True).stdout
    m = re.search(r"page size of (\d+)", out)
    if not m:
        return None
    ps = int(m.group(1))
    pages = 0
    for k in ("Pages free", "Pages inactive", "Pages speculative", "Pages purgeable"):
        mm = re.search(rf"{k}:\s+(\d+)", out)
        if mm:
            pages += int(mm.group(1))
    return pages * ps / 1e9


def swap_used_gb():
    if sys.platform != "darwin":
        return None
    out = subprocess.run(["sysctl", "-n", "vm.swapusage"], capture_output=True, text=True).stdout
    m = re.search(r"used\s*=\s*([\d.]+)M", out)
    return float(m.group(1)) / 1024 if m else None


def detect_compute():
    """G6-1: what compute exists on this box. Loads nothing, probes cheaply.

    Returns {"gpu": None|"metal"|"cuda", "unified": bool, "vram_gb": float|None,
    "device": str}. VRAM is the DISCRETE card's own memory (None for unified,
    where GPU and CPU share one pool and 'adding' the GPU adds no cache)."""
    if sys.platform == "darwin" and platform.machine() == "arm64":
        return {"gpu": "metal", "unified": True, "vram_gb": None, "device": "Apple Silicon (unified memory)"}
    smi = shutil.which("nvidia-smi")
    if smi:
        out = subprocess.run([smi, "--query-gpu=name,memory.total", "--format=csv,noheader"],
                             capture_output=True, text=True).stdout.strip().splitlines()
        if out:
            name, _, mem = out[0].partition(",")
            m = re.search(r"([\d.]+)\s*MiB", mem)
            vram = float(m.group(1)) * 1.048576e-3 if m else None
            return {"gpu": "cuda", "unified": False, "vram_gb": vram, "device": name.strip()}
    return {"gpu": None, "unified": False, "vram_gb": None, "device": "CPU only"}


def choose_backend(hw, model_bytes):
    """The measured placement policy (G6-1). Returns (backend, reason, validated).

    Only VALIDATED branches are auto-enabled; predicted branches are printed as
    recommendations pending hardware and the default stays the validated one.
    - unified (Apple): CPU. Measured: below ~0.9 hit the backends tie (1.56 vs
      1.55-1.62 tok/s) while GPU costs ~3 GB extra and prefills token-by-token;
      the GPU's +23% only exists at hit >= ~0.9 (lablog GPU rungs).
    - discrete VRAM >= model: fully resident on GPU - no streaming at all.
    - discrete VRAM < model: hybrid placement (trunk in VRAM, expert cache
      spanning VRAM+RAM). Engine orchestration for this is not built; predicted.
    - no GPU: CPU, trivially."""
    if hw["gpu"] is None:
        return "cpu", "no GPU present", True
    if hw["unified"]:
        return "cpu", "unified memory: streaming is disk-bound (backends tie below ~0.9 hit) and GPU costs ~3 GB + slow prefill — measured", True
    if hw["vram_gb"] and model_bytes / 1e9 * 1.15 <= hw["vram_gb"]:
        return "gpu", f"model fits in {hw['vram_gb']:.0f} GB VRAM — fully resident, no streaming", False
    return "hybrid", "discrete VRAM extends the expert cache (trunk in VRAM, cache spans VRAM+RAM) — predicted best, engine orchestration pending", False


def cmd_doctor(args):
    """Preflight: will this machine run a model well, and how fast? Loads nothing."""
    name = args[0] if args and args[0] in REGISTRY else None
    ok, warn = [], []
    P, F, W = f"{GREEN}✓{RESET}", f"{YELLOW}✗{RESET}", f"{YELLOW}!{RESET}"
    print(f"{BOLD}sluice doctor{RESET}{DIM} — preflight, no model is loaded{RESET}\n")

    # --- 1. memory -----------------------------------------------------------
    ram = os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES") / 1e9
    av = avail_ram_gb()
    print(f"{BOLD}memory{RESET}")
    print(f"  {P} installed            {ram:.0f} GB")
    if av is None:
        print(f"  {W} available            unknown (non-macOS)")
    else:
        mark = P if av >= 8 else (W if av >= 4 else F)
        print(f"  {mark} available            {av:.2f} GB"
              f"{'' if av >= 8 else DIM + '  (streaming wants >= 8 GB free; close apps)' + RESET}")
        if av < 8:
            warn.append(f"only {av:.1f} GB free — expect the memory guard to shed cache slots")
        if av < 4:
            ok.append(False)
    sw = swap_used_gb()
    if sw is not None:
        mark = P if sw < 0.5 else W
        print(f"  {mark} swap in use          {sw:.2f} GB"
              f"{'' if sw < 0.5 else DIM + '  (already paging — speeds below will not hold)' + RESET}")
        if sw >= 0.5:
            warn.append(f"{sw:.1f} GB of swap in use; the machine is already paging")

    # --- 2. engine + strays --------------------------------------------------
    print(f"\n{BOLD}engine{RESET}")
    if ENGINE.exists():
        print(f"  {P} built                {ENGINE.relative_to(ROOT)}")
    else:
        print(f"  {F} not built            run: bash scripts/install.sh")
        ok.append(False)
    # protocol #1, promoted from a lab rule to a user-facing check: a second engine
    # took this machine into swap once (2026-07-19) and the symptom was a hang.
    stray = subprocess.run(["pgrep", "-f", "csrc/stream_run"], capture_output=True, text=True)
    if stray.returncode == 0:
        pids = " ".join(stray.stdout.split())
        print(f"  {F} another engine running  pid(s) {pids} — one model at a time")
        ok.append(False)
    else:
        print(f"  {P} no stray engines")

    # --- 2b. compute (G6-1) --------------------------------------------------
    print(f"\n{BOLD}compute{RESET}")
    hw = detect_compute()
    print(f"  {P} detected             {hw['device']}")
    mb = REGISTRY[name]["bytes"] if name else max(m["bytes"] for m in REGISTRY.values())
    backend, reason, validated = choose_backend(hw, mb)
    if validated:
        print(f"  {P} backend              {backend}{DIM}  ({reason}){RESET}")
    else:
        print(f"  {W} backend              cpu for now{DIM}  (predicted best: {backend} — {reason};"
              f" not auto-enabled until measured){RESET}")

    # --- 3. disk -------------------------------------------------------------
    print(f"\n{BOLD}disk{RESET}")
    free = shutil.disk_usage(str(ROOT)).free / 1e9
    print(f"  {P if free > 20 else W} free space           {free:.0f} GB")
    sample = next((p for n in REGISTRY if (p := model_path(n)) and p.exists()
                   and p.stat().st_size > 1e9), None)
    bw = None
    if sample:
        bw = measure_disk_bw(sample)
        mark = P if bw >= 1.0 else W
        print(f"  {mark} cold read bandwidth  {bw:.2f} GB/s{DIM}  (reference machine: {REF_BW_GBS} GB/s){RESET}")
    else:
        print(f"  {W} cold read bandwidth  not measured (no model on disk to sample)")

    # --- 4. models -----------------------------------------------------------
    print(f"\n{BOLD}models{RESET}")
    for n in ([name] if name else list(REGISTRY)):
        p, want = model_path(n), REGISTRY[n]["bytes"]
        if p and p.exists():
            got = p.stat().st_size
            # exact-bytes logic, matching cmd_run/cmd_pull. These sizes are the
            # server's Content-Length (scripts/check_urls.py), not rounded — a
            # rounded-UP size made a COMPLETE file look truncated forever.
            if got >= want * 0.99:
                print(f"  {P} {n:<14} on disk, {got/1e9:.2f} GB")
            else:
                print(f"  {W} {n:<14} PARTIAL {got/1e9:.2f}/{want/1e9:.2f} GB — `sluice pull {n}` resumes")
        else:
            print(f"  {DIM}·{RESET} {n:<14} not downloaded ({want/1e9:.1f} GB)")

    # --- 5. speed prediction -------------------------------------------------
    if name:
        print(f"\n{BOLD}predicted speed — {name}{RESET}")
        for l in fmt_modes(name, {"disk_gbs": bw}):
            print(l)
        if av is not None and av < 8:
            print(f"  {DIM}measured load curve: 6.14 tok/s at 9.2 GB free, 4.89 at 8.4, "
                  f"1.57 at 1.5 (E37c/E37d/E37) — you are at {av:.1f}{RESET}")
        print(f"  {DIM}{REGISTRY[name]['note']}{RESET}")
    else:
        print(f"\n{DIM}pass a model name for a speed prediction: sluice doctor {list(REGISTRY)[1]}{RESET}")

    # --- 6. verdict ----------------------------------------------------------
    good = all(ok) if ok else True
    print()
    if good and not warn:
        print(f"{GREEN}{BOLD}GO{RESET} — nothing blocking.")
    elif good:
        print(f"{YELLOW}{BOLD}GO, with caveats{RESET}")
        for w in warn:
            print(f"  {DIM}·{RESET} {w}")
        print(f"{DIM}  It will run. The speeds above assume a quiet machine.{RESET}")
    else:
        print(f"{YELLOW}{BOLD}NO-GO{RESET} — fix the ✗ items above first.")
    return 0 if good else 1


def cmd_urls(args):
    """HEAD-check every model URL. Delegates to the checker so there is one
    implementation, not a CLI copy that can drift from it."""
    script = ROOT / "scripts" / "check_urls.py"
    if not script.exists():
        print(f"{YELLOW}scripts/check_urls.py is missing{RESET}"); return 1
    print(f"{BOLD}model URL reachability{RESET}{DIM} — HEAD only, downloads nothing{RESET}")
    return subprocess.call([sys.executable, str(script)] + list(args))


def cmd_run(args):
    usage = (f"usage: sluice run <{'|'.join(REGISTRY)}> [--mode exact|balanced|fast] "
             f"[--reasoning {'|'.join(REASONING)}] [--backend auto|cpu|gpu]")
    if not args or args[0] not in REGISTRY:
        print(usage); return 1
    name = args[0]
    mode = "balanced"
    if "--mode" in args:
        mode = args[args.index("--mode") + 1]
    # G6-1: backend selection. auto = the measured policy (choose_backend);
    # gpu = manual override into the known-safe GPU config (SLOT_DEV=gpu NGL=99,
    # token-by-token prefill, no CPU prefill pool — the UI's E24 constraints).
    backend = "auto"
    if "--backend" in args:
        backend = args[args.index("--backend") + 1].lower()
        if backend not in ("auto", "cpu", "gpu"):
            print(f"unknown backend {backend!r}\n{usage}"); return 1
    if backend == "auto":
        hw = detect_compute()
        chosen, reason, validated = choose_backend(hw, REGISTRY[name]["bytes"])
        backend = chosen if (validated and chosen in ("cpu", "gpu")) else "cpu"
        print(f"{DIM}backend: {backend} — {reason}{RESET}")
    reasoning = "low"
    if "--reasoning" in args:
        reasoning = args[args.index("--reasoning") + 1].lower()
        if reasoning not in REASONING:
            print(f"unknown reasoning level {reasoning!r}\n{usage}"); return 1
        if reasoning != "low":
            # say it before the wait, not after: at streamed speeds the extra
            # hidden tokens are the wait
            print(f"{DIM}reasoning={reasoning}: more hidden thinking before the first "
                  f"visible word — expect a slower first token.{RESET}")
    if not ensure_engine_built():
        return 1
    p = model_path(name)
    if not p.exists() or p.stat().st_size < REGISTRY[name]["bytes"] * 0.99:
        print(f"{DIM}{name} isn't on disk yet — pulling it first (like ollama)…{RESET}")
        if cmd_pull([name]) != 0:
            return 1
        p = model_path(name)
    if subprocess.run(["pgrep", "-f", "stream_run"], capture_output=True).returncode == 0:
        print("another engine/benchmark is running - one model at a time (machine-safety rule)")
        return 1

    env = os.environ.copy()
    env.update({
        "LLMSTREAM_SLOTS": str(REGISTRY[name]["slots"]),
        **mode_env(mode),
        "LLMSTREAM_SERVER": "1", "LLMSTREAM_STREAM_OUT": "1", "LLMSTREAM_CHAT": "1",
        "LLMSTREAM_IDLE_EXIT": "600", "LLMSTREAM_PREFILL_SLOTS": "1",
        "LLMSTREAM_SYSTEM": system_with_reasoning(reasoning),
    })
    # E41b canon: ON by default for chat (S3). Client-side flip — the engine default
    # stays OFF so gates and harnesses keep their pinned config. LLMSTREAM_KV_CANON=0
    # disables it.
    env["LLMSTREAM_KV_CANON"] = os.environ.get("LLMSTREAM_KV_CANON", "1")
    # G5-1 KV persistence: ON by default for chat (owner decision 2026-07-23). The
    # checkpoint is keyed to the exact model file (<model>.kv beside it), so
    # switching models can never resume another model's state. Same contract as
    # canon: resume is config-pinned same-quality, not token-identical to an
    # uninterrupted session (results/g5kv: 2/3 chats identical, one 1-in-180
    # argmax flip, RC4 class). =0/off disables; any other value is a custom path.
    _kv = os.environ.get("LLMSTREAM_KV_PERSIST")
    if _kv in ("0", "off", ""):
        env.pop("LLMSTREAM_KV_PERSIST", None)
    else:
        env["LLMSTREAM_KV_PERSIST"] = _kv or str(p) + ".kv"
    # G6-1: GPU config mirrors the UI's known-safe shape — expert slots on GPU,
    # full offload, token-by-token prefill (the CPU prefill pool does not exist
    # on GPU; a batched prefill whose union overflows the slots is a D12 exit).
    ubatch = "128"
    if backend == "gpu":
        env["LLMSTREAM_SLOT_DEV"] = "gpu"
        env["LLMSTREAM_NGL"] = "99"
        env.pop("LLMSTREAM_PREFILL_SLOTS", None)
        ubatch = "1"
    print(f"{DIM}loading {name} ({mode} mode, {backend}) - one-time, stays warm…{RESET}")
    proc = subprocess.Popen([str(ENGINE), str(p), "512", "CLI_REPL", ubatch],
                            env=env, cwd=ROOT, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL)

    def read_until(marker):
        buf = b""
        while marker not in buf:
            b1 = proc.stdout.read(1)
            if not b1:
                if proc.poll() is not None:
                    print("engine exited"); sys.exit(1)
                continue
            buf += b1
        return buf

    read_until(b"<<<READY>>>")
    print(f"{GREEN}ready.{RESET} {DIM}multi-turn, KV-reused, expert-major prefill. /exit to quit.{RESET}")
    history = []
    try:
        while True:
            try:
                msg = input(f"\n{BOLD}you>{RESET} ").strip()
            except EOFError:
                break
            if not msg or msg == "/exit":
                break
            history.append(("user", msg))
            clean = lambda t: t.replace("\x1e", " ").replace("\x1f", " ").replace("\n", "\\n")
            req = "\x1e".join(f"{r}\x1f{clean(t)}" for r, t in history)
            proc.stdin.write(req.encode() + b"\n")
            proc.stdin.flush()
            read_until(b"<<<STREAM>>>\n")
            print(f"{CYAN}model>{RESET} ", end="", flush=True)
            out = b""
            t0 = time.time()
            while b"<<<END>>>" not in out:
                c = proc.stdout.read(1)
                if not c:
                    if proc.poll() is not None:
                        break
                    continue
                out += c
                if b"<<<END>>>" not in out:
                    sys.stdout.write(c.decode(errors="replace"))
                    sys.stdout.flush()
            tail = read_until(b"<<<READY>>>").decode(errors="replace")
            import re as _re
            reply = _re.sub(r"<\|[^|]*\|>", " ", out.replace(b"<<<END>>>", b"").decode(errors="replace"))
            m = _re.search(r"decode:\s+[\d.]+ s \(([\d.]+) tok/s\)", tail)
            r2 = _re.search(r"reused=(\d+)", tail)
            bits = [f"{time.time()-t0:.1f}s"]
            if m: bits.append(f"{m.group(1)} tok/s")
            if r2 and int(r2.group(1)): bits.append(f"reused {r2.group(1)} ctx")
            # E41b client contract. Note what `reply` actually is: every harmony
            # marker stripped, which concatenates the analysis and final channels.
            # That is precisely the text the template will NOT render next turn, so
            # storing it guarantees a full re-prefill. canon_reply is the fix.
            canon = parse_canon_reply(tail)
            stored = canon if canon is not None else reply.strip()
            if canon is not None:
                bits.append("canon")
                if canon.strip() != reply.strip():
                    # visible, never silent: the symptom of getting this wrong is
                    # only "it got slower", which is the hardest kind of bug to see
                    print(f"{YELLOW}[kv-canon: stored reply differs from our extraction "
                          f"({len(reply.strip())} chars -> {len(canon.strip())}); using the "
                          f"engine's canonical form so the next turn can reuse the KV]{RESET}")
            print(f"\n{DIM}[{' · '.join(bits)}]{RESET}")
            history.append(("assistant", stored))
    finally:
        try:
            proc.stdin.write(b"exit\n"); proc.stdin.flush()
            proc.wait(timeout=3)
        except Exception:
            proc.terminate()
    print(f"{DIM}engine stopped.{RESET}")
    return 0


def resolve_model(ref):
    """Registry name OR a filesystem path to a .gguf. Returns (path, label, is_registry)."""
    if ref in REGISTRY:
        return model_path(ref), ref, True
    p = Path(ref).expanduser()
    if p.exists() and p.suffix == ".gguf":
        return p, p.stem, False
    return None, None, False


def _serve_spawn(path, is_registry, name, mode, temp, system):
    """Spawn ONE warm engine (CPU backend — GPU is the Apple-Silicon footgun, E24/D12).
    Slots: registry hint if known, else the engine auto-sizes to free RAM (dynamic)."""
    env = os.environ.copy()
    env.update({
        "LLMSTREAM_SERVER": "1", "LLMSTREAM_STREAM_OUT": "1", "LLMSTREAM_CHAT": "1",
        "LLMSTREAM_IDLE_EXIT": "600", "LLMSTREAM_PREFILL_SLOTS": "1",
        **mode_env(mode),
        "LLMSTREAM_TEMP": str(temp), "LLMSTREAM_TOP_P": "0.9",
        "LLMSTREAM_TOP_K": "40", "LLMSTREAM_REP_PEN": "1.1", "LLMSTREAM_REP_LAST": "64",
        "LLMSTREAM_SYSTEM": system,
    })
    if is_registry:
        env["LLMSTREAM_SLOTS"] = str(REGISTRY[name]["slots"])  # else: engine auto-sizes to RAM
    proc = subprocess.Popen([str(ENGINE), str(path), "512", "SERVER_API", "128"],
                            env=env, cwd=ROOT, stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    buf = b""
    while b"<<<READY>>>" not in buf:
        c = proc.stdout.read(1)
        if not c:
            if proc.poll() is not None:
                raise RuntimeError("engine died during load")
            continue
        buf += c
    return proc


def cmd_serve(args):
    """OpenAI-compatible HTTP server. `sluice serve [model] [--port N] [--mode ..] [--temp T]`.
    Model loads lazily on first request (server starts instantly, like `ollama serve`)."""
    import http.server, threading, re as _re
    port = int(args[args.index("--port") + 1]) if "--port" in args else 11434
    mode = args[args.index("--mode") + 1] if "--mode" in args else "balanced"
    temp = float(args[args.index("--temp") + 1]) if "--temp" in args else 0.8
    default_ref = next((a for a in args if not a.startswith("--") and a not in
                        (mode, str(temp), str(port))), None)

    if not ensure_engine_built():
        return 1
    eng = {"proc": None, "key": None, "lock": threading.Lock()}
    strip = lambda t: _re.sub(r"<\|[^|]*\|>", "", t)

    def ensure(ref, sysmsg):
        path, name, is_reg = resolve_model(ref)
        if path is None or not path.exists():
            raise FileNotFoundError(f"model not found: {ref} (try a registry name or a .gguf path)")
        key = (str(path), mode, temp, sysmsg)
        with eng["lock"]:
            if eng["proc"] and eng["proc"].poll() is None and eng["key"] == key:
                return
            if eng["proc"]:
                try: eng["proc"].stdin.write(b"exit\n"); eng["proc"].stdin.flush()
                except Exception: pass
            eng["proc"] = _serve_spawn(path, is_reg, name, mode, temp, sysmsg)
            eng["key"] = key

    def chat(messages, model):
        sysmsg = next((m["content"] for m in messages if m.get("role") == "system"),
                      "You are a helpful, concise assistant. Reasoning: low")
        turns = [(m["role"], m["content"]) for m in messages if m.get("role") in ("user", "assistant")]
        ensure(model, sysmsg)
        proc = eng["proc"]
        clean = lambda t: t.replace("\x1e", " ").replace("\x1f", " ").replace("\n", "\\n")
        req = "\x1e".join(f"{r}\x1f{clean(t)}" for r, t in turns)
        with eng["lock"]:
            proc.stdin.write(req.encode() + b"\n"); proc.stdin.flush()
            buf = b""
            while b"<<<STREAM>>>\n" not in buf:
                c = proc.stdout.read(1);  buf += c if c else b""
                if not c and proc.poll() is not None: return
            out = b""
            while b"<<<END>>>" not in out:
                c = proc.stdout.read(1)
                if not c:
                    if proc.poll() is not None: break
                    continue
                out += c
                if b"<<<END>>>" not in out:
                    yield strip(c.decode(errors="replace"))
            tail = b""
            while b"<<<READY>>>" not in tail:
                c = proc.stdout.read(1);  tail += c if c else b""
                if not c and proc.poll() is not None: break

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a): pass
        def _json(self, code, obj):
            b = json.dumps(obj).encode()
            self.send_response(code); self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(b))); self.end_headers(); self.wfile.write(b)
        def do_GET(self):
            if self.path.rstrip("/") in ("/v1/models", "/api/tags"):
                data = [{"id": n, "object": "model", "owned_by": "sluice"} for n in REGISTRY]
                self._json(200, {"object": "list", "data": data})
            elif self.path.rstrip("/") in ("", "/health"):
                self._json(200, {"status": "ok", "engine": "sluice", "backend": "cpu"})
            else:
                self._json(404, {"error": "not found"})
        def do_POST(self):
            if self.path.rstrip("/") != "/v1/chat/completions":
                return self._json(404, {"error": "only /v1/chat/completions"})
            n = int(self.headers.get("Content-Length", 0))
            body = json.loads(self.rfile.read(n) or b"{}")
            msgs = body.get("messages", [])
            stream = bool(body.get("stream"))
            want = body.get("model") or default_ref or list(REGISTRY)[1]
            model = want if resolve_model(want)[0] else (default_ref or list(REGISTRY)[1])
            try:
                if stream:
                    self.send_response(200)
                    self.send_header("Content-Type", "text/event-stream")
                    self.end_headers()
                    for tok in chat(msgs, model):
                        ch = {"choices": [{"delta": {"content": tok}, "index": 0}]}
                        self.wfile.write(f"data: {json.dumps(ch)}\n\n".encode()); self.wfile.flush()
                    self.wfile.write(b"data: [DONE]\n\n"); self.wfile.flush()
                else:
                    text = "".join(chat(msgs, model))
                    self._json(200, {"object": "chat.completion", "model": model,
                        "choices": [{"index": 0, "finish_reason": "stop",
                                     "message": {"role": "assistant", "content": text.strip()}}]})
            except Exception as e:
                self._json(500, {"error": str(e)})

    srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), H)
    print(f"{GREEN}sluice serve{RESET} on {BOLD}http://127.0.0.1:{port}{RESET}  "
          f"{DIM}(OpenAI-compatible /v1/chat/completions · CPU backend · model loads on first request){RESET}")
    print(f"{DIM}  default model: {default_ref or list(REGISTRY)[1]} · mode {mode} · temp {temp}{RESET}")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print(f"\n{DIM}stopping…{RESET}")
        if eng["proc"]:
            try: eng["proc"].stdin.write(b"exit\n"); eng["proc"].stdin.flush()
            except Exception: pass
    return 0


def main():
    cmds = {"list": cmd_list, "estimate": cmd_estimate, "pull": cmd_pull,
            "rm": cmd_rm, "ui": cmd_ui, "run": cmd_run, "serve": cmd_serve,
            "doctor": cmd_doctor, "urls": cmd_urls}
    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
        print(__doc__.strip())
        return 1
    return cmds[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    sys.exit(main())
