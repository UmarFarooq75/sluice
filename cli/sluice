BOLD, DIM, RESET, CYAN, GREEN, YELLOW = "\033[1m", "\033[2m", "\033[0m", "\033[36m", "\033[32m", "\033[33m"


def model_path(name):
    r = REGISTRY[name]
    if r.get("file"):
        return MODELS_DIR / r["file"]
    hits = sorted(ROOT.glob(r["hf_glob"]))
    return hits[0] if hits else MODELS_DIR / f"{name}.gguf"


def measure_disk_bw(sample_file):
    """Read 32 random 8MB spans of a big file - cold-ish sequential-random mix,
    the pattern expert streaming actually does. Returns GB/s."""
    size = sample_file.stat().st_size
    span = 8 * 1024 * 1024
    n = 32
    fd = os.open(str(sample_file), os.O_RDONLY)
    try:
        try:
            import fcntl
            F_NOCACHE = 48
            fcntl.fcntl(fd, F_NOCACHE, 1)  # macOS: bypass page cache = honest cold reads
        except Exception:
            pass
        rng = random.Random(42)
        t0 = time.time()
        got = 0
        for _ in range(n):
            off = rng.randrange(0, max(1, size - span)) & ~4095
            got += len(os.pread(fd, span, off))
        dt = time.time() - t0
    finally:
        os.close(fd)
    return got / dt / 1e9


def machine_probe():
    ram = os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES") / 1e9
    free_disk = shutil.disk_usage(str(ROOT)).free / 1e9
    sample = next((p for n in REGISTRY if (p := model_path(n)) and p.exists() and p.stat().st_size > 1e9), None)
    bw = measure_disk_bw(sample) if sample else None
    return {"ram_gb": ram, "free_disk_gb": free_disk, "disk_gbs": bw}


def fmt_modes(name, probe):
    r = REGISTRY[name]
    lines = []
    scale = (probe["disk_gbs"] / REF_BW_GBS) if probe.get("disk_gbs") else 1.0
    for mode, m in r["modes"].items():
        if m["toks"] is None:
            lines.append(f"    {mode:<26} not yet measured")
            continue
        t = m["toks"] * (scale if m["io_bound"] else 1.0)
        prov = "scaled to your disk" if (m["io_bound"] and probe.get("disk_gbs")) else "measured"
        lines.append(f"    {mode:<26} {BOLD}{t:5.1f} tok/s{RESET}  {DIM}({prov}){RESET}")
    return lines


def cmd_list(_):
    probe = {"disk_gbs": None}
    print(f"{BOLD}models{RESET}  ({MODELS_DIR}){DIM} · sluice estimate <name> for honest speeds{RESET}")
    for name in REGISTRY:
        p = model_path(name)
        want = REGISTRY[name]["bytes"]
        if p and p.exists() and p.stat().st_size >= want * 0.99:
            mark = f"{GREEN}on disk{RESET}"
        elif p and p.exists():
            mark = f"{YELLOW}partial {p.stat().st_size/1e9:.1f}/{want/1e9:.1f} GB (pull resumes it){RESET}"
        else:
            mark = f"{DIM}pull to get ({want/1e9:.1f} GB){RESET}"
        print(f"  {CYAN}{name:<14}{RESET} {REGISTRY[name]['size']:<38} {mark}")
    return 0


def cmd_estimate(args):
    names = [args[0]] if args else list(REGISTRY)
    print(f"{DIM}probing this machine (RAM, disk bandwidth - takes ~10s)…{RESET}")
    probe = machine_probe()
    bw = f"{probe['disk_gbs']:.1f} GB/s" if probe["disk_gbs"] else "unknown (no big file to sample)"
    print(f"{BOLD}this machine{RESET}: RAM {probe['ram_gb']:.0f} GB · free disk "
          f"{probe['free_disk_gb']:.0f} GB · cold read {bw}\n")
    for name in names:
        if name not in REGISTRY:
            print(f"unknown model: {name}"); return 1
        r = REGISTRY[name]
        print(f"{CYAN}{name}{RESET}  {r['size']}")
        for l in fmt_modes(name, probe):
            print(l)
        print(f"    {DIM}{r['note']}{RESET}\n")
    print(f"{DIM}reference: M2 Air 16GB @ {REF_BW_GBS} GB/s cold reads; every number has a lab "
          f"artifact (docs/lablog.md). I/O-bound modes scale with disk; resident modes with compute.{RESET}")
    return 0


def cmd_pull(args):
    if not args or args[0] not in REGISTRY:
        print(f"usage: sluice pull <{'|'.join(REGISTRY)}>"); return 1
    name = args[0]
    r = REGISTRY[name]
    dst = model_path(name)
    if dst.exists() and dst.stat().st_size >= r["bytes"] * 0.99:
        print(f"{name} already on disk: {dst}"); return 0
    cmd_estimate([name])
    need = r["bytes"] / 1e9
    free = shutil.disk_usage(str(ROOT)).free / 1e9
    print(f"download {need:.1f} GB -> {dst}  (free disk now: {free:.0f} GB, after: {free - need:.0f} GB)")
    if free - need < 8:
        print(f"{YELLOW}warning: this leaves <8 GB free - macOS degrades (swap, pressure) below that.{RESET}")
    if input("proceed? [y/N] ").strip().lower() != "y":
        print("aborted"); return 1
    dst.parent.mkdir(parents=True, exist_ok=True)
    return subprocess.call(["curl", "-L", "-C", "-", "-o", str(dst), r["url"]])


def cmd_rm(args):
    if not args or args[0] not in REGISTRY:
        print(f"usage: sluice rm <{'|'.join(REGISTRY)}>"); return 1
    p = model_path(args[0])
    if not p.exists():
        print("not on disk"); return 1
    print(f"delete {p} ({p.stat().st_size/1e9:.1f} GB)?")
    if input("confirm [y/N] ").strip().lower() != "y":
        print("aborted"); return 1
    p.unlink()
    print("deleted (re-pull any time - the measurements stay in results/)")
    return 0


def cmd_ui(_):
    app = ROOT / "ui" / "app.py"
    st = ROOT / ".venv" / "bin" / "streamlit"
    exe = str(st) if st.exists() else "streamlit"
    os.execvp(exe, [exe, "run", str(app)])


MODES = {"exact": 0.0, "balanced": 0.25, "fast": 1.25}


def cmd_run(args):
    if not args or args[0] not in REGISTRY:
        print(f"usage: sluice run <{'|'.join(REGISTRY)}> [--mode exact|balanced|fast]"); return 1
    name = args[0]
    mode = "balanced"
    if "--mode" in args:
        mode = args[args.index("--mode") + 1]
    p = model_path(name)
    if not p.exists() or p.stat().st_size < REGISTRY[name]["bytes"] * 0.99:
        print(f"{name} not fully on disk - `sluice pull {name}` first"); return 1
    if subprocess.run(["pgrep", "-f", "stream_run"], capture_output=True).returncode == 0:
        print("another engine/benchmark is running - one model at a time (machine-safety rule)")
        return 1

    env = os.environ.copy()
    env.update({
        "LLMSTREAM_SLOTS": str(REGISTRY[name]["slots"]),
        "LLMSTREAM_MARGIN": str(MODES.get(mode, 0.25)),
        "LLMSTREAM_SERVER": "1", "LLMSTREAM_STREAM_OUT": "1", "LLMSTREAM_CHAT": "1",
        "LLMSTREAM_IDLE_EXIT": "600", "LLMSTREAM_PREFILL_SLOTS": "1",
        "LLMSTREAM_SYSTEM": "You are a helpful, concise assistant. Answer the user's message directly. Reasoning: low",
    })
    print(f"{DIM}loading {name} ({mode} mode) - one-time, stays warm…{RESET}")
    proc = subprocess.Popen([str(ENGINE), str(p), "512", "CLI_REPL", "128"],
                            env=env, cwd=ROOT, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL)

    def read_until(marker):
        buf = b""
        while marker not in buf:
            b1 = proc.stdout.read(1)
            if not b1:
                if proc.poll() is not None:
                    print("engine exited"); sys.exit(1)
                continue
            buf += b1
        return buf

    read_until(b"<<<READY>>>")
    print(f"{GREEN}ready.{RESET} {DIM}multi-turn, KV-reused, expert-major prefill. /exit to quit.{RESET}")
    history = []
    try:
        while True:
            try:
                msg = input(f"\n{BOLD}you>{RESET} ").strip()
            except EOFError:
                break
            if not msg or msg == "/exit":
                break
            history.append(("user", msg))
            clean = lambda t: t.replace("\x1e", " ").replace("\x1f", " ").replace("\n", "\\n")
            req = "\x1e".join(f"{r}\x1f{clean(t)}" for r, t in history)
            proc.stdin.write(req.encode() + b"\n")
            proc.stdin.flush()
            read_until(b"<<<STREAM>>>\n")
            print(f"{CYAN}model>{RESET} ", end="", flush=True)
            out = b""
            t0 = time.time()
            while b"<<<END>>>" not in out:
                c = proc.stdout.read(1)
                if not c:
                    if proc.poll() is not None:
                        break
                    continue
                out += c
                if b"<<<END>>>" not in out:
                    sys.stdout.write(c.decode(errors="replace"))
                    sys.stdout.flush()
            tail = read_until(b"<<<READY>>>").decode(errors="replace")
            import re as _re
            reply = _re.sub(r"<\|[^|]*\|>", " ", out.replace(b"<<<END>>>", b"").decode(errors="replace"))
            m = _re.search(r"decode:\s+[\d.]+ s \(([\d.]+) tok/s\)", tail)
            r2 = _re.search(r"reused=(\d+)", tail)
            bits = [f"{time.time()-t0:.1f}s"]
            if m: bits.append(f"{m.group(1)} tok/s")
            if r2 and int(r2.group(1)): bits.append(f"reused {r2.group(1)} ctx")
            print(f"\n{DIM}[{' · '.join(bits)}]{RESET}")
            history.append(("assistant", reply.strip()))
    finally:
        try:
            proc.stdin.write(b"exit\n"); proc.stdin.flush()
            proc.wait(timeout=3)
        except Exception:
            proc.terminate()
    print(f"{DIM}engine stopped.{RESET}")
    return 0


def resolve_model(ref):
    """Registry name OR a filesystem path to a .gguf. Returns (path, label, is_registry)."""
    if ref in REGISTRY:
        return model_path(ref), ref, True
    p = Path(ref).expanduser()
    if p.exists() and p.suffix == ".gguf":
        return p, p.stem, False
    return None, None, False


def _serve_spawn(path, is_registry, name, mode, temp, system):
    """Spawn ONE warm engine (CPU backend — GPU is the Apple-Silicon footgun, E24/D12).
    Slots: registry hint if known, else the engine auto-sizes to free RAM (dynamic)."""
    env = os.environ.copy()
    env.update({
        "LLMSTREAM_SERVER": "1", "LLMSTREAM_STREAM_OUT": "1", "LLMSTREAM_CHAT": "1",
        "LLMSTREAM_IDLE_EXIT": "600", "LLMSTREAM_PREFILL_SLOTS": "1",
        "LLMSTREAM_MARGIN": str(MODES.get(mode, 0.25)),
        "LLMSTREAM_TEMP": str(temp), "LLMSTREAM_TOP_P": "0.9",
        "LLMSTREAM_TOP_K": "40", "LLMSTREAM_REP_PEN": "1.1", "LLMSTREAM_REP_LAST": "64",
        "LLMSTREAM_SYSTEM": system,
    })
    if is_registry:
        env["LLMSTREAM_SLOTS"] = str(REGISTRY[name]["slots"])  # else: engine auto-sizes to RAM
    proc = subprocess.Popen([str(ENGINE), str(path), "512", "SERVER_API", "128"],
                            env=env, cwd=ROOT, stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    buf = b""
    while b"<<<READY>>>" not in buf:
        c = proc.stdout.read(1)
        if not c:
            if proc.poll() is not None:
                raise RuntimeError("engine died during load")
            continue
        buf += c
    return proc


def cmd_serve(args):
    """OpenAI-compatible HTTP server. `sluice serve [model] [--port N] [--mode ..] [--temp T]`.
    Model loads lazily on first request (server starts instantly, like `ollama serve`)."""
    import http.server, threading, re as _re
    port = int(args[args.index("--port") + 1]) if "--port" in args else 11434
    mode = args[args.index("--mode") + 1] if "--mode" in args else "balanced"
    temp = float(args[args.index("--temp") + 1]) if "--temp" in args else 0.8
    default_ref = next((a for a in args if not a.startswith("--") and a not in
                        (mode, str(temp), str(port))), None)

    eng = {"proc": None, "key": None, "lock": threading.Lock()}
    strip = lambda t: _re.sub(r"<\|[^|]*\|>", "", t)

    def ensure(ref, sysmsg):
        path, name, is_reg = resolve_model(ref)
        if path is None or not path.exists():
            raise FileNotFoundError(f"model not found: {ref} (try a registry name or a .gguf path)")
        key = (str(path), mode, temp, sysmsg)
        with eng["lock"]:
            if eng["proc"] and eng["proc"].poll() is None and eng["key"] == key:
                return
            if eng["proc"]:
                try: eng["proc"].stdin.write(b"exit\n"); eng["proc"].stdin.flush()
                except Exception: pass
            eng["proc"] = _serve_spawn(path, is_reg, name, mode, temp, sysmsg)
            eng["key"] = key

    def chat(messages, model):
        sysmsg = next((m["content"] for m in messages if m.get("role") == "system"),
                      "You are a helpful, concise assistant. Reasoning: low")
        turns = [(m["role"], m["content"]) for m in messages if m.get("role") in ("user", "assistant")]
        ensure(model, sysmsg)
        proc = eng["proc"]
        clean = lambda t: t.replace("\x1e", " ").replace("\x1f", " ").replace("\n", "\\n")
        req = "\x1e".join(f"{r}\x1f{clean(t)}" for r, t in turns)
        with eng["lock"]:
            proc.stdin.write(req.encode() + b"\n"); proc.stdin.flush()
            buf = b""
            while b"<<<STREAM>>>\n" not in buf:
                c = proc.stdout.read(1);  buf += c if c else b""
                if not c and proc.poll() is not None: return
            out = b""
            while b"<<<END>>>" not in out:
                c = proc.stdout.read(1)
                if not c:
                    if proc.poll() is not None: break
                    continue
                out += c
                if b"<<<END>>>" not in out:
                    yield strip(c.decode(errors="replace"))
            tail = b""
            while b"<<<READY>>>" not in tail:
                c = proc.stdout.read(1);  tail += c if c else b""
                if not c and proc.poll() is not None: break

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a): pass
        def _json(self, code, obj):
            b = json.dumps(obj).encode()
            self.send_response(code); self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(b))); self.end_headers(); self.wfile.write(b)
        def do_GET(self):
            if self.path.rstrip("/") in ("/v1/models", "/api/tags"):
                data = [{"id": n, "object": "model", "owned_by": "sluice"} for n in REGISTRY]
                self._json(200, {"object": "list", "data": data})
            elif self.path.rstrip("/") in ("", "/health"):
                self._json(200, {"status": "ok", "engine": "sluice", "backend": "cpu"})
            else:
                self._json(404, {"error": "not found"})
        def do_POST(self):
            if self.path.rstrip("/") != "/v1/chat/completions":
                return self._json(404, {"error": "only /v1/chat/completions"})
            n = int(self.headers.get("Content-Length", 0))
            body = json.loads(self.rfile.read(n) or b"{}")
            msgs = body.get("messages", [])
            stream = bool(body.get("stream"))
            want = body.get("model") or default_ref or list(REGISTRY)[1]
            model = want if resolve_model(want)[0] else (default_ref or list(REGISTRY)[1])
            try:
                if stream:
                    self.send_response(200)
                    self.send_header("Content-Type", "text/event-stream")
                    self.end_headers()
                    for tok in chat(msgs, model):
                        ch = {"choices": [{"delta": {"content": tok}, "index": 0}]}
                        self.wfile.write(f"data: {json.dumps(ch)}\n\n".encode()); self.wfile.flush()
                    self.wfile.write(b"data: [DONE]\n\n"); self.wfile.flush()
                else:
                    text = "".join(chat(msgs, model))
                    self._json(200, {"object": "chat.completion", "model": model,
                        "choices": [{"index": 0, "finish_reason": "stop",
                                     "message": {"role": "assistant", "content": text.strip()}}]})
            except Exception as e:
                self._json(500, {"error": str(e)})

    srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), H)
    print(f"{GREEN}sluice serve{RESET} on {BOLD}http://127.0.0.1:{port}{RESET}  "
          f"{DIM}(OpenAI-compatible /v1/chat/completions · CPU backend · model loads on first request){RESET}")
    print(f"{DIM}  default model: {default_ref or list(REGISTRY)[1]} · mode {mode} · temp {temp}{RESET}")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print(f"\n{DIM}stopping…{RESET}")
        if eng["proc"]:
            try: eng["proc"].stdin.write(b"exit\n"); eng["proc"].stdin.flush()
            except Exception: pass
    return 0


def main():
    cmds = {"list": cmd_list, "estimate": cmd_estimate, "pull": cmd_pull,
            "rm": cmd_rm, "ui": cmd_ui, "run": cmd_run, "serve": cmd_serve}
    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
        print(__doc__.strip())
        return 1
    return cmds[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    sys.exit(main())
