diff --git a/src/llmstream.cpp b/src/llmstream.cpp
new file mode 100644
index 0000000..7ac093a
--- /dev/null
+++ b/src/llmstream.cpp
@@ -0,0 +1,66 @@
+#include "llmstream.h"
+
+#include "llama-impl.h"
+#include "llama-model-loader.h"
+
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+
+#include <cstdlib>
+#include <map>
+#include <string>
+
+static struct {
+    ggml_context * ctx = nullptr;
+    ggml_backend_buffer_t buf = nullptr;
+    std::map<std::string, ggml_tensor *> tensors;
+} g_llmstream;
+
+int64_t llmstream_slots(void) {
+    static int64_t n = -1;
+    if (n < 0) {
+        const char * s = getenv("LLMSTREAM_SLOTS");
+        n = s ? atoll(s) : 0;
+        if (n < 0) n = 0;
+    }
+    return n;
+}
+
+bool llmstream_dup_ids(void) {
+    static const bool dup_only = getenv("LLMSTREAM_DUP_ONLY") != nullptr;
+    return llmstream_slots() > 0 || dup_only;
+}
+
+ggml_tensor * llmstream_slot_tensor(llama_model_loader & ml, const char * name_full,
+        int64_t ne0, int64_t ne1, int64_t n_slots) {
+    if (!g_llmstream.ctx) {
+        ggml_init_params params = {
+            /*.mem_size   =*/ ggml_tensor_overhead() * 4096,
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        g_llmstream.ctx = ggml_init(params);
+        GGML_ASSERT(g_llmstream.ctx);
+    }
+    ggml_tensor * meta = ml.require_tensor_meta(name_full);
+    ggml_tensor * t = ggml_new_tensor_3d(g_llmstream.ctx, meta->type, ne0, ne1, n_slots);
+    ggml_set_name(t, name_full);
+    g_llmstream.tensors[name_full] = t;
+    return t;
+}
+
+void llmstream_alloc(void) {
+    if (!g_llmstream.ctx || g_llmstream.buf) {
+        return;
+    }
+    g_llmstream.buf = ggml_backend_alloc_ctx_tensors_from_buft(g_llmstream.ctx, ggml_backend_cpu_buffer_type());
+    GGML_ASSERT(g_llmstream.buf);
+    ggml_backend_buffer_clear(g_llmstream.buf, 0);
+    LLAMA_LOG_INFO("llmstream: %zu slot tensors, %.2f MiB expert cache\n",
+            g_llmstream.tensors.size(), ggml_backend_buffer_get_size(g_llmstream.buf) / 1024.0 / 1024.0);
+}
+
+ggml_tensor * llmstream_get_tensor(const char * name_full) {
+    auto it = g_llmstream.tensors.find(name_full);
+    return it == g_llmstream.tensors.end() ? nullptr : it->second;
+}
diff --git a/src/llmstream.h b/src/llmstream.h
new file mode 100644
index 0000000..bc75f66
--- /dev/null
+++ b/src/llmstream.h
@@ -0,0 +1,35 @@
+#pragma once
+
+// llmstream: expert-streaming support (private fork, not for upstream).
+// When LLMSTREAM_SLOTS=<n> is set, MoE expert tensors are created with n cache
+// slots per layer instead of n_expert, their GGUF data is not loaded, and the
+// graph exposes a per-layer "ffn_moe_topk_slots" ids tensor that an external
+// driver rewrites from expert ids to slot ids via the cb_eval callback after
+// filling the slots from storage.
+
+#include "llama.h"
+#include "ggml.h"
+
+#include <cstdint>
+
+struct llama_model_loader;
+
+// slots per layer from LLMSTREAM_SLOTS; 0 = streaming disabled
+LLAMA_API int64_t llmstream_slots(void);
+
+// whether build_moe_ffn should emit the ids copy node: streaming enabled, or
+// LLMSTREAM_DUP_ONLY=1 (debug: isolate the copy node's effect on the graph
+// while expert tensors stay fully resident)
+LLAMA_API bool llmstream_dup_ids(void);
+
+// create a slot-backed expert tensor. name_full is the GGUF tensor name (used
+// only to look up the ggml type); the tensor is ne0 x ne1 x n_slots in a
+// dedicated CPU context, allocated by llmstream_alloc().
+ggml_tensor * llmstream_slot_tensor(llama_model_loader & ml, const char * name_full,
+        int64_t ne0, int64_t ne1, int64_t n_slots);
+
+// allocate the slot context's CPU buffer; call once after all slot tensors are created
+void llmstream_alloc(void);
+
+// driver access to the slot tensors registered by llmstream_slot_tensor()
+LLAMA_API ggml_tensor * llmstream_get_tensor(const char * name_full);
