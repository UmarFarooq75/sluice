diff --git a/src/llmstream.cpp b/src/llmstream.cpp
new file mode 100644
index 0000000..bdb472a
--- /dev/null
+++ b/src/llmstream.cpp
@@ -0,0 +1,152 @@
+#include "llmstream.h"
+
+#include "llama-impl.h"
+#include "llama-model-loader.h"
+
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <string>
+
+static struct {
+    ggml_context * ctx = nullptr;
+    ggml_backend_buffer_t buf = nullptr;
+    std::map<std::string, ggml_tensor *> tensors;
+} g_llmstream;
+
+int64_t llmstream_slots(void) {
+    static int64_t n = -1;
+    if (n < 0) {
+        const char * s = getenv("LLMSTREAM_SLOTS");
+        n = s ? atoll(s) : 0;
+        if (n < 0) n = 0;
+    }
+    return n;
+}
+
+bool llmstream_dup_ids(void) {
+    static const bool dup_only = getenv("LLMSTREAM_DUP_ONLY") != nullptr;
+    return llmstream_slots() > 0 || dup_only;
+}
+
+int64_t llmstream_prefill_slots(int64_t n_expert) {
+    static int64_t env_n = -1;
+    if (env_n < 0) {
+        const char * s = getenv("LLMSTREAM_PREFILL_SLOTS");
+        env_n = s ? atoll(s) : 0;
+        if (env_n < 0) env_n = 0;
+    }
+    if (env_n == 0) return 0;
+    if (env_n == 1 || env_n >= n_expert) return n_expert; // auto / clamp
+    return env_n;
+}
+
+static ggml_context * llmstream_ctx(void) {
+    if (!g_llmstream.ctx) {
+        ggml_init_params params = {
+            /*.mem_size   =*/ ggml_tensor_overhead() * 8192,
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        g_llmstream.ctx = ggml_init(params);
+        GGML_ASSERT(g_llmstream.ctx);
+    }
+    return g_llmstream.ctx;
+}
+
+ggml_tensor * llmstream_slot_tensor(llama_model_loader & ml, const char * name_full,
+        int64_t ne0, int64_t ne1, int64_t n_slots) {
+    ggml_tensor * meta = ml.require_tensor_meta(name_full);
+    ggml_tensor * t = ggml_new_tensor_3d(llmstream_ctx(), meta->type, ne0, ne1, n_slots);
+    ggml_set_name(t, name_full);
+    g_llmstream.tensors[name_full] = t;
+    return t;
+}
+
+ggml_tensor * llmstream_slot_tensor_2d(llama_model_loader & ml, const char * name_full,
+        int64_t ne0, int64_t n_slots) {
+    ggml_tensor * meta = ml.require_tensor_meta(name_full);
+    ggml_tensor * t = ggml_new_tensor_2d(llmstream_ctx(), meta->type, ne0, n_slots);
+    ggml_set_name(t, name_full);
+    g_llmstream.tensors[name_full] = t;
+    return t;
+}
+
+ggml_tensor * llmstream_pf_tensor_typed(ggml_type type, const char * pf_name,
+        int64_t ne0, int64_t ne1, int64_t n_slots) {
+    if (g_llmstream.tensors.count(pf_name)) return g_llmstream.tensors[pf_name];
+    ggml_tensor * t = ggml_new_tensor_3d(llmstream_ctx(), type, ne0, ne1, n_slots);
+    ggml_set_name(t, pf_name);
+    g_llmstream.tensors[pf_name] = t;
+    return t;
+}
+
+ggml_tensor * llmstream_pf_tensor_typed_2d(ggml_type type, const char * pf_name,
+        int64_t ne0, int64_t n_slots) {
+    if (g_llmstream.tensors.count(pf_name)) return g_llmstream.tensors[pf_name];
+    ggml_tensor * t = ggml_new_tensor_2d(llmstream_ctx(), type, ne0, n_slots);
+    ggml_set_name(t, pf_name);
+    g_llmstream.tensors[pf_name] = t;
+    return t;
+}
+
+void llmstream_pf_twin(const ggml_tensor * slot_t, const char * kind, int64_t n_pf) {
+    char pfn[128];
+    snprintf(pfn, sizeof(pfn), "llmstream_pf.%s.%s", kind, ggml_type_name(slot_t->type));
+    if (slot_t->ne[2] == 1) {
+        llmstream_pf_tensor_typed_2d(slot_t->type, pfn, slot_t->ne[0], n_pf);
+    } else {
+        llmstream_pf_tensor_typed(slot_t->type, pfn, slot_t->ne[0], slot_t->ne[1], n_pf);
+    }
+}
+
+void llmstream_alloc(void) {
+    if (!g_llmstream.ctx || g_llmstream.buf) {
+        return;
+    }
+    // LLMSTREAM_SLOT_DEV=<device name>: allocate slot tensors in that
+    // backend's buffers instead of CPU. On Apple Silicon the Metal buffer is
+    // host-visible shared memory, so the driver's pread() fills work
+    // unchanged while the GPU reads the same pages - this removes the
+    // scheduler's cross-backend input snapshot, which goes stale when the
+    // cache fills tensors mid-graph (measured: hybrid GPU runs with CPU slot
+    // tensors produce corrupt output). Host-visible backends only.
+    ggml_backend_buffer_type_t buft = ggml_backend_cpu_buffer_type();
+    const char * slot_dev = getenv("LLMSTREAM_SLOT_DEV");
+    if (slot_dev && *slot_dev) {
+        ggml_backend_dev_t dev = ggml_backend_dev_by_name(slot_dev);
+        if (!dev && strcmp(slot_dev, "gpu") == 0) {
+            // portable alias: first GPU-type device (Metal = "MTL0", CUDA0, ...)
+            for (size_t i = 0; i < ggml_backend_dev_count(); i++) {
+                ggml_backend_dev_t d = ggml_backend_dev_get(i);
+                if (ggml_backend_dev_type(d) == GGML_BACKEND_DEVICE_TYPE_GPU) { dev = d; break; }
+            }
+        }
+        if (dev) {
+            buft = ggml_backend_dev_buffer_type(dev);
+            LLAMA_LOG_INFO("llmstream: slot tensors on device '%s' (buft %s)\n",
+                    slot_dev, ggml_backend_buft_name(buft));
+        } else {
+            LLAMA_LOG_WARN("llmstream: LLMSTREAM_SLOT_DEV device '%s' not found, using CPU\n", slot_dev);
+        }
+    }
+    g_llmstream.buf = ggml_backend_alloc_ctx_tensors_from_buft(g_llmstream.ctx, buft);
+    GGML_ASSERT(g_llmstream.buf);
+    ggml_backend_buffer_clear(g_llmstream.buf, 0);
+    LLAMA_LOG_INFO("llmstream: %zu slot tensors, %.2f MiB expert cache\n",
+            g_llmstream.tensors.size(), ggml_backend_buffer_get_size(g_llmstream.buf) / 1024.0 / 1024.0);
+}
+
+ggml_tensor * llmstream_get_tensor(const char * name_full) {
+    auto it = g_llmstream.tensors.find(name_full);
+    return it == g_llmstream.tensors.end() ? nullptr : it->second;
+}
+
+void llmstream_free(void) {
+    if (g_llmstream.buf) { ggml_backend_buffer_free(g_llmstream.buf); g_llmstream.buf = nullptr; }
+    if (g_llmstream.ctx) { ggml_free(g_llmstream.ctx); g_llmstream.ctx = nullptr; }
+    g_llmstream.tensors.clear();
+}
diff --git a/src/llmstream.h b/src/llmstream.h
new file mode 100644
index 0000000..c84df80
--- /dev/null
+++ b/src/llmstream.h
@@ -0,0 +1,67 @@
+#pragma once
+
+// llmstream: expert-streaming support (private fork, not for upstream).
+// When LLMSTREAM_SLOTS=<n> is set, MoE expert tensors are created with n cache
+// slots per layer instead of n_expert, their GGUF data is not loaded, and the
+// graph exposes a per-layer "ffn_moe_topk_slots" ids tensor that an external
+// driver rewrites from expert ids to slot ids via the cb_eval callback after
+// filling the slots from storage.
+
+#include "llama.h"
+#include "ggml.h"
+
+#include <cstdint>
+
+struct llama_model_loader;
+
+// slots per layer from LLMSTREAM_SLOTS; 0 = streaming disabled
+LLAMA_API int64_t llmstream_slots(void);
+
+// whether build_moe_ffn should emit the ids copy node: streaming enabled, or
+// LLMSTREAM_DUP_ONLY=1 (debug: isolate the copy node's effect on the graph
+// while expert tensors stay fully resident)
+LLAMA_API bool llmstream_dup_ids(void);
+
+// create a slot-backed expert tensor. name_full is the GGUF tensor name (used
+// only to look up the ggml type); the tensor is ne0 x ne1 x n_slots in a
+// dedicated CPU context, allocated by llmstream_alloc().
+ggml_tensor * llmstream_slot_tensor(llama_model_loader & ml, const char * name_full,
+        int64_t ne0, int64_t ne1, int64_t n_slots);
+
+// 2D variant for per-expert bias vectors (gpt-oss family): ne0 x n_slots,
+// the slot dimension replacing the expert dimension ggml_add_id indexes
+ggml_tensor * llmstream_slot_tensor_2d(llama_model_loader & ml, const char * name_full,
+        int64_t ne0, int64_t n_slots);
+
+// prefill pool (E27): slots in ONE shared expert-tensor set that every layer
+// reuses during multi-token ubatches, so a batch's expert union can never
+// overflow per-layer slot caches (closes D12). LLMSTREAM_PREFILL_SLOTS:
+// 0/unset = off; 1 = auto (n_expert); other values clamp to <= n_expert.
+LLAMA_API int64_t llmstream_prefill_slots(int64_t n_expert);
+
+// pf-pool tensors, one per (kind, ggml type) variant: mixed-quant GGUFs
+// (e.g. Q4_K_M puts Q6_K on some layers' ffn_down and Q4_K on others) need a
+// correctly-typed pool per variant - a single layer-0-typed pool dequantizes
+// other layers' bytes as the wrong format (found by the E27 gate, D14).
+// Registered as "llmstream_pf.<kind>.<type_name>"; build_moe_ffn picks the
+// variant matching the layer tensor's own type.
+ggml_tensor * llmstream_pf_tensor_typed(ggml_type type, const char * pf_name,
+        int64_t ne0, int64_t ne1, int64_t n_slots);
+ggml_tensor * llmstream_pf_tensor_typed_2d(ggml_type type, const char * pf_name,
+        int64_t ne0, int64_t n_slots);
+
+// create (idempotently) the pf twin for one layer's slot tensor: model load
+// calls this per layer per kind, and each distinct type variant materializes
+// on first sight - no pre-scan of layer types needed
+void llmstream_pf_twin(const ggml_tensor * slot_t, const char * kind, int64_t n_pf);
+
+// allocate the slot context's CPU buffer; call once after all slot tensors are created
+void llmstream_alloc(void);
+
+// free the slot buffer + context. Call before process exit when slot tensors
+// live in a device buffer: backend registries destruct at exit and abort if
+// buffers still hold references (measured: ggml_metal_device_free assert).
+LLAMA_API void llmstream_free(void);
+
+// driver access to the slot tensors registered by llmstream_slot_tensor()
+LLAMA_API ggml_tensor * llmstream_get_tensor(const char * name_full);
